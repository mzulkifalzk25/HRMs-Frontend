# FormbaxHR frontend environment variables.
# Copy to .env.local (gitignored) and adjust. Values are bundled into the browser app:
# never put secrets, passwords or tokens here.

# Base URL of the Django REST API (http or https, no trailing slash needed).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# "true" = use mock services with fictional data; "false" = call the API above.
# Required in production builds; development falls back to the values in this file.
VITE_USE_MOCK_API=true
