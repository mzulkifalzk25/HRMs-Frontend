{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "jsx-a11y", "import"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "import/no-cycle": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@/services/mock",
              "@/services/mock/**",
              "**/services/mock",
              "**/services/mock/**",
              "**/*.mock",
              "*.mock"
            ],
            "message": "UI and feature code must not import mock services directly (D-026). Use the service registry in src/services/. See docs/ARCHITECTURE.md."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/components/ui/**"],
      "rules": {
        "react/only-export-components": "off",
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    },
    {
      "files": [
        "src/services/**",
        "src/**/*.mock.ts",
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/test/**"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["src/components/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/services/mock",
                  "@/services/mock/**",
                  "**/services/mock",
                  "**/services/mock/**",
                  "**/*.mock",
                  "*.mock"
                ],
                "message": "UI and feature code must not import mock services directly (D-026). Use the service registry in src/services/. See docs/ARCHITECTURE.md."
              },
              {
                "group": ["@/features/**", "**/features/**"],
                "message": "Shared components must not depend on features. Move the shared part into src/components/ or src/lib/. See docs/ARCHITECTURE.md."
              }
            ]
          }
        ]
      }
    }
  ]
}
